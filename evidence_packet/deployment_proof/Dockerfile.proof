# Builds the SHAKTI dashboard (apps/shakti) out of the npm-workspaces
# monorepo and serves its production dist via nginx.
#
# Build from the repo root:
#   docker build -t shakti-dashboard .
# Run:
#   docker run -p 8080:80 shakti-dashboard

FROM node:22-alpine AS build
WORKDIR /repo

# Copy workspace manifests first to leverage Docker layer caching
COPY package.json package-lock.json ./
COPY apps/shakti/package.json apps/shakti/package.json
COPY packages/utils/package.json packages/utils/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/dashboard-sdk/package.json packages/dashboard-sdk/package.json
COPY packages/dashboard-layout/package.json packages/dashboard-layout/package.json

RUN npm ci

# Copy full source trees
COPY tsconfig.base.json ./
COPY packages/ packages/
COPY apps/shakti/ apps/shakti/

# Build workspace packages, then shakti app
RUN npm run build:packages && npm run build:shakti

# ---- runtime: thin nginx image serving static files ----
FROM nginx:alpine AS runtime

COPY --from=build /repo/apps/shakti/dist /usr/share/nginx/html

RUN echo $'server {\n\
    listen 80;\n\
    server_name localhost;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
\n\
    location = /health {\n\
        default_type application/json;\n\
        return 200 \'{"status":"healthy","service":"shakti-dashboard"}\';\n\
    }\n\
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
