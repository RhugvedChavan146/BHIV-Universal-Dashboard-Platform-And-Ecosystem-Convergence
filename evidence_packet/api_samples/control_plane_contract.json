    "bucket": [
      { "path": "/bucket/artifacts", "method": "GET", "clientFn": "fetchBucketArtifacts" },
      { "path": "/bucket/storage-stats", "method": "GET", "clientFn": "fetchBucketStorageStats" },
      { "path": "/bucket/chain-state", "method": "GET", "clientFn": "fetchBucketChainState" },
      { "path": "/audit/recent", "method": "GET", "clientFn": "fetchAuditRecent" },
