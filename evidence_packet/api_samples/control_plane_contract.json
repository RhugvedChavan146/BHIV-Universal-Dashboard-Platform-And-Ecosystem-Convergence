      { "path": "/bucket/status", "method": "GET", "clientFn": "fetchInsightFlowBucketStatus" }
    ],
    "niyantran": [
      { "path": "/api/dashboard/stats", "method": "GET", "clientFn": "fetchNiyantranStats" },
      { "path": "/api/dashboard/attendance-summary", "method": "GET", "clientFn": "fetchNiyantranAttendanceSummary" },
      { "path": "/api/dashboard/leaderboard", "method": "GET", "clientFn": "fetchNiyantranLeaderboard" },
      { "path": "/api/aims", "method": "GET", "clientFn": "fetchNiyantranAims" }
    ],
    "prana": [
      { "path": "/health", "method": "GET", "clientFn": "fetchPranaHealth" },
      { "path": "/prana/propagation-log", "method": "GET", "clientFn": "fetchPranaPropagationLog" }
    ]
  }
}
