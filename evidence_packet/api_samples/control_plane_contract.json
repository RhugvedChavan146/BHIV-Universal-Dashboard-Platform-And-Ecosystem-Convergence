{
  "version": "1.0.0",
  "services": {
    "controlPlane": [
      { "path": "/health", "method": "GET", "clientFn": "fetchHealth" },
      { "path": "/system/status", "method": "GET", "clientFn": "fetchSystemStatus" },
      { "path": "/metrics", "method": "GET", "clientFn": "fetchMetrics" },
      { "path": "/dashboard/executive", "method": "GET", "clientFn": "fetchExecutiveDashboard" },
      { "path": "/dashboard/operations", "method": "GET", "clientFn": "fetchOperationsDashboard" },
      { "path": "/dashboard/alerts", "method": "GET", "clientFn": "fetchAlertsDashboard" },
      { "path": "/dashboard/runtime", "method": "GET", "clientFn": "fetchRuntimeDashboard" },
      { "path": "/dashboard/telemetry", "method": "GET", "clientFn": "fetchTelemetryDashboard" },
      { "path": "/registry/repositories", "method": "GET", "clientFn": "fetchRepositoryRegistry" },
      { "path": "/registry/builds", "method": "GET", "clientFn": "fetchBuildRegistry" },
      { "path": "/registry/capabilities", "method": "GET", "clientFn": "fetchCapabilityRegistry" },
      { "path": "/registry/executions", "method": "GET", "clientFn": "fetchExecutionRegistry" },
      { "path": "/registry/replays", "method": "GET", "clientFn": "fetchReplayRegistry" }
